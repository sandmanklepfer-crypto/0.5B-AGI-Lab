# ============================================================
# 复制成 .secrets/xxx.env 使用，千万不要提交真 key
# ============================================================
# 频道名（vault 和 agent 必须一致，建议随机串）
VAULT_CHAN=change-me-to-random
# 签名密钥（防伪造请求，建议随机串）
VAULT_HMAC=change-me-to-random-too

# ---- DeepSeek ----
DS_KEY=<你的key>
# 或 DEEPSEEK_API_KEY=<你的key>

# ---- 腾讯混元（聊天，OpenAI 兼容）----
# HY_KEY=<你的key>
# HY_BASE=https://api.hunyuan.cloud.tencent.com/v1
# HY_MODEL=hunyuan-lite
