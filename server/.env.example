# ===== 卤味小店 支付服务器 配置 =====
# 用法：把本文件复制为 server/.env，填入真实值

# 对外可访问的 HTTPS 地址（微信回调必须能访问到它，末尾不要带斜杠）
PUBLIC_BASE_URL=https://pay.example.com
# 本地调试留空即可

# 服务端口
PORT=8787

# 老板查订单接口用的密钥，随便改长一点
ADMIN_TOKEN=please-change-this-token

# ---------- 微信支付 v3（Native 扫码支付）----------
# 商户号
WXPAY_MCHID=1900000000
# 公众号/小程序的 appid（在商户平台「产品中心-开发配置」查看）
WXPAY_APPID=wx0000000000000000
# 商户 API 证书序列号
WXPAY_SERIAL_NO=0000000000000000000000000000000000000000
# APIv3 密钥（32 位）
WXPAY_APIV3_KEY=00000000000000000000000000000000
# 商户 API 私钥文件（apiclient_key.pem）
WXPAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
# 微信支付公钥（推荐，商户平台-API安全-微信支付公钥 下载）
WXPAY_PUBLIC_KEY_PATH=./cert/pub_key.pem
WXPAY_PUBLIC_KEY_ID=PUB_KEY_ID_0000000000000000000000000000000000000
# 若只下载了「平台证书」，改用这一行（二选一，优先用公钥）
# WXPAY_PLATFORM_CERT_PATH=./cert/platform_cert.pem
# 回调路径（一般不用改）
WXPAY_NOTIFY_PATH=/api/pay/notify

# ---------- 付款成功后通知老板 ----------
# 可选：自建通知地址（企业微信机器人 / 飞书机器人 / Bark 等）
# 例：企业微信 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx 需要 {text} 结构，本服务发的是 JSON
# 建议留空，改用网页后台里配的邮箱（data/settings.json 的 orderForm）
MERCHANT_WEBHOOK=

# ---------- 订单存储 ----------
# local  = 写在服务器本地文件（自己的服务器 / 有持久盘，推荐）
# github = 写进你的 GitHub 仓库（免费 PaaS 磁盘会被清空时用它，重启不丢单）
STORAGE=local
# 订单文件路径（STORAGE=local 时有效）
# ORDERS_FILE=./data/orders.json

# 下面几项只在 STORAGE=github 时需要
# GH_TOKEN=ghp_xxxxxxxxxxxx          # 只需要 Contents 读写权限
# GH_OWNER=你的用户名
# GH_REPO=你的仓库名
# GH_BRANCH=main
# GH_FILE=server-orders/orders.json

# 演示模式：置 1 时不接微信，用页面上的「模拟支付成功」走通全流程
MOCK=0
