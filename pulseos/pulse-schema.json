{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sandmanklepfer-crypto.github.io/0.5B-AGI-Lab/pulseos/pulse-schema.json",
  "title": "PulseOS Capability Manifest",
  "description": "机器可读的能力清单。只描述能做什么和去哪里调，不执行任何东西。",
  "type": "object",
  "required": ["manifest_version", "name", "capabilities", "gateway"],
  "properties": {
    "manifest_version": { "type": "integer", "const": 1 },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "human_readable": { "type": "string", "format": "uri" },
    "_readme": { "type": "array", "items": { "type": "string" }, "description": "给 AI 的使用说明" },

    "gateway": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": {
          "type": "boolean",
          "description": "false 表示当前没有在线网关，任何 invoke 都会失败。调用前必须先确认这个字段。"
        },
        "reason": { "type": "string" },
        "health_check": {
          "type": "object",
          "properties": {
            "method": { "type": "string", "const": "GET" },
            "url": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "invoke": {
          "type": "object",
          "properties": {
            "method": { "type": "string", "enum": ["POST"] },
            "url": { "type": ["string", "null"] },
            "content_type": { "type": "string" },
            "body_schema": { "type": "object" },
            "response_schema": { "type": "object" }
          }
        }
      }
    },

    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "params"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "default": {},
                "description": { "type": "string" }
              }
            }
          },
          "expected_ms": { "type": "number", "description": "典型耗时，用于 AI 决定是否值得调用" },
          "side_effects": {
            "type": "string",
            "enum": ["none", "writes_state", "creates_service", "external_api_call"],
            "description": "none = 幂等只读，可以放心重试；其它需要谨慎"
          },
          "idempotent": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },

    "limits": {
      "type": "object",
      "properties": {
        "max_state_bytes": { "type": "integer" },
        "max_args_bytes": { "type": "integer" },
        "rate_limit_per_hour": { "type": "integer" },
        "note": { "type": "string" }
      }
    },

    "signing": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "header": { "type": "string" },
        "canonical": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "alternatives": { "type": "object" },
    "contact": { "type": "object" }
  }
}
