# 笔记服务 —— 最小示例
# 演示：状态声明、追加、派生因果

service notes {
  state {
    items: list = []
    count: int  = 0
  }

  on "add"(text) {
    append(items, text)
    set count = count + 1
    # 派生：通知下游"笔记变了"
    emit "changed" { n: count, last: text }
  }

  on "list" {
    return items
  }

  on "stats" {
    return { n: count, size: len(items) }
  }
}
